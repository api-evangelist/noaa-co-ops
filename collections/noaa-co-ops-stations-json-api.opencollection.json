{
  "opencollection": "1.0.0",
  "info": {
    "name": "NOAA CO-OPS Data Retrieval Benchmarks Stations.json API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Stations.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
