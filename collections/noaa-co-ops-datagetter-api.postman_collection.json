      "item": [
        {
          "id": "468cc6d6-c3c8-4460-8dc3-238530e46cc3",
          "name": "Retrieve observational or prediction data",
          "request": {
            "name": "Retrieve observational or prediction data",
            "description": {
              "content": "Returns tides, water levels, currents, meteorological observations, or predictions from a specified NOAA CO-OPS station for a given time range and product type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datagetter"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "station",
                  "value": "<string>",
                  "description": "(Required) 7-character station ID (e.g., 9414290) or currents station code (e.g., cb1401)."
                },
                {
                  "disabled": false,
                  "key": "product",
                  "value": "<string>",
                  "description": "(Required) The type of data product to retrieve."
                },
                {
                  "disabled": false,
                  "key": "begin_date",
                  "value": "<string>",
                  "description": "Start date for data retrieval. Format: yyyyMMdd or MM/dd/yyyy. Required unless using `date` or `range`."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "End date for data retrieval. Format: yyyyMMdd or MM/dd/yyyy. Required unless using `date` or `range`."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Quick time reference shorthand. Mutually exclusive with begin_date/end_date/range."
                },
                {
                  "disabled": false,
                  "key": "range",
                  "value": "<integer>",
                  "description": "Hours of data to retrieve from the current time (or from begin_date if supplied). Use `range=1` to `range=48` for sub-daily products; large values for predictions."
                },
                {
                  "disabled": false,
                  "key": "datum",
                  "value": "<string>",
                  "description": "Vertical datum for water level data. Required for water_level and predictions products."
                },
                {
                  "disabled": false,
                  "key": "time_zone",
                  "value": "gmt",
                  "description": "Time zone for returned timestamps."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "Data interval. Use 'h' for hourly, or integer minutes (1, 6, 15, 30, 60). Applies to water_level and currents."
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "metric",
                  "description": "Measurement unit system."
                },
                {
                  "disabled": false,
                  "key": "bin",
                  "value": "<integer>",
                  "description": "Current depth bin number for ADCP currents data."
                },
                {
                  "disabled": false,
                  "key": "vel_type",
                  "value": "<string>",
                  "description": "Current velocity output format."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format."
                },
                {
                  "disabled": false,
                  "key": "application",
                  "value": "<string>",
                  "description": "Identifier for the calling application. Helps NOAA track usage."
                },
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Include additional detail in currents response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
